# manager.env -- configuration for an nm2munin manager/bridge deployment.
# Copy to manager.env and edit for your topology. This file is the ONLY place
# that knows which agents you monitor; the daemons and units are generic.
#
# Prerequisite (out of scope for this project): the host already runs an ION
# node plus an `nm_agent`/`nm_mgr`-capable stack. See examples/two-node-lab for
# one way to stand that up.

# System user/group the bridge + manager run as (must own /var/lib/nm).
ION_USER=iondtn
ION_GROUP=iondtn

# Where bridge.py + nm_mgr_run.py are installed and run from.
INSTALL_DIR=/opt/nm2munin

# EID of the local NM manager (nm_mgr -A argument).
MGR_EID=ipn:1.1

# Space-separated EIDs of the agents this manager polls for reports.
NM_AGENTS="ipn:1.2 ipn:2.1"

# EID=port map the bridge exposes to the Munin master, one local TCP port per
# agent. Munin's munin-conf.d/dtn.conf is generated from this. Add an entry per
# agent in NM_AGENTS, each on a free port.
BRIDGE_MAP="ipn:1.2=4950 ipn:2.1=4951"

# Reporting period, seconds: how often each agent reports, and the resolution
# Munin keeps the samples at (it applies to the RRD files it creates).
NM_INTERVAL=30

# How the agents come to report (default tbr):
#   tbr   a time-based rule on each agent runs the report controls every
#         NM_INTERVAL on the agent's own clock, so it keeps measuring while its
#         link is down and the reports arrive later, stamped with their time.
#         The manager sends the rule again every NM_TBR_REFRESH seconds, for an
#         agent that restarted; one that has it ignores the copy.
#   poll  the manager sends the report controls every NM_INTERVAL; nothing is
#         measured while an agent's link is down, and with ION's NM (4.2.0,
#         and integration as of 2026-11-17) the controls that queue meanwhile
#         end nm_agent when they arrive together (docs/architecture.md).
NM_REPORTING=tbr
NM_TBR_REFRESH=300

# Address the bridge binds its per-EID ports on (the Munin master is local).
NM2MUNIN_BIND=127.0.0.1

# Graphs the bridge does NOT expose to Munin (data still collected, just not
# drawn). Space-separated graph keys; leave empty to show every graph. Default
# hides low-value / mostly-static graphs.
HIDDEN_GRAPHS="ion_clock ion_rates nm_other ion_sdr_storage ion_sdr_heap ion_sdr_congestion sys_cpus"
